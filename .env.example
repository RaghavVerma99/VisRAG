# ===========================================================================
# Multimodal RAG — configuration template
# Copy to `.env`, fill in, and never commit it. Field names map 1:1 onto
# `src/config.py` (pydantic-settings, case-insensitive, `.env` aware).
# ===========================================================================

# --- Paths -----------------------------------------------------------------
DATA_RAW=data/raw
DATA_PROCESSED=data/processed
DATA_EVAL=data/eval_set

# --- Vector store ----------------------------------------------------------
# embedded = local on-disk Qdrant, no server (v0 default, see ADR-011)
# server   = remote; QDRANT_URL is required
QDRANT_MODE=embedded
QDRANT_PATH=.qdrant
QDRANT_URL=
QDRANT_COLLECTION=elements_v1

# --- Models ----------------------------------------------------------------
# Recorded in every payload (`model_version`) and in every eval report.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_MODEL=openai/clip-vit-base-patch32
DEVICE=cpu

# Caption provider: openai | anthropic | local-llava
# Hosted captioning requires approval for sensitive documents (root AGENTS.md §9).
CAPTION_PROVIDER=openai
CAPTION_MODEL=gpt-4o-mini
CAPTION_LOCAL_MODEL=llava-hf/llava-1.5-7b-hf

# --- Generation ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VISION_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_IMAGES=4
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Retrieval -------------------------------------------------------------
TOP_K=8
RRF_K=60
RERANK_CANDIDATES=16
ABSTAIN_THRESHOLD=0.30

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_SIMILARITY=0.95
CACHE_TTL_S=86400
CACHE_VERSION=1

# --- Reproducibility -------------------------------------------------------
SEED=42
